{
  "name": "slide2pdf-office-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Slide2Pdf add-in for PowerPoint",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "deploy": "npm run build && wrangler deploy",
    "dev-server": "webpack serve --mode development",
    "start": "webpack serve --mode development",
    "sideload": "node scripts/sideload.mjs",
    "sideload:local": "node scripts/sideload.mjs manifest.local.xml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml",
    "validate:local": "office-addin-manifest validate manifest.local.xml"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "4.7.0",
    "buffer": "6.0.3",
    "isomorphic-git": "1.40.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/office-js": "1.0.600",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.2",
    "fake-indexeddb": "6.2.4",
    "fs-extra": "11.4.0",
    "html-webpack-plugin": "5.6.7",
    "office-addin-dev-certs": "2.0.10",
    "office-addin-manifest": "2.1.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.109.0",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0",
    "wrangler": "4.114.0"
  }
}
